# ==========================================
# Firebase Client SDK Configuration (Frontend / Web)
# Get these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ==========================================
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# ==========================================
# Firebase Admin SDK Configuration (Backend Server)
# Option 1: Path to downloaded Service Account JSON file (recommended for local dev)
# Get from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# ==========================================
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Environment variables directly (useful for cloud deployment like Vercel / Render)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
