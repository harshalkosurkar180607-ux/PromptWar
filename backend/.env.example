# Server Port
PORT=5000

# ==============================================================
# EMAIL DELIVERY CONFIGURATION
# Choose ONE of the following options:
# ==============================================================

# Option 1: Resend API Key (Simplest API key option - https://resend.com)
RESEND_API_KEY=

# Option 2: Brevo API Key (https://brevo.com)
BREVO_API_KEY=

# Option 3: Gmail App Password / Generic SMTP
# (Google Account -> Security -> 2-Step Verification -> App Passwords)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="Promptwar <no-reply@promptwar.com>"

# ==============================================================
# OTP SETTINGS
# ==============================================================
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Firebase Service Account Path (optional)
FIREBASE_SERVICE_ACCOUNT_PATH=../database/serviceAccountKey.json
